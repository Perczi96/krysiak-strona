# ============================================
# BEZ MASKI - Environment Variables
# Skopiuj ten plik do .env i uzupełnij własnymi wartościami
# ============================================

# Supabase (pobierz z Settings → API w dashboardzie Supabase)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (test mode na start - klucze z Dashboard → Developers → API keys)
# Tryb testowy: klucze zaczynają się od sk_test_ / pk_test_
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# STRIPE_SECRET_KEY=sk_test_your-secret-key  # TYLKO w Edge Functions (Supabase Vault / Secrets)

# Web Push VAPID keys (generuj: npx web-push generate-vapid-keys)
# Publiczny klucz do frontendu
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# Prywatny klucz TYLKO w Edge Functions (Supabase Vault / Secrets)
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:your-email@example.com

# Google OAuth (opcjonalnie - na później)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# App config
VITE_APP_URL=https://your-project.pages.dev
VITE_APP_NAME=Bez Maski

# Test mode switch (do testowania strefy supporter bez Stripe)
# true = symuluje status supportera dla zalogowanego użytkownika
VITE_TEST_MODE=false

# Feature flags
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_COMMENTS=true
VITE_ENABLE_ANALYTICS=true
